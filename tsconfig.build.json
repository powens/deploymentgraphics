{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./lib",
    "sourceMap": false,
    "declaration": true
  },
  // bundle.ts and viewer-controls.ts are demo-only and unreachable from the
  // package entry points.
  "exclude": [
    "node_modules",
    "dist",
    "lib",
    "static",
    "src/bundle.ts",
    "src/viewer-controls.ts",
    "**/*.test.ts"
  ]
}
