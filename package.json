{
  "name": "deploymentgraphics",
  "version": "0.1.0",
  "description": "Render Warhammer 40k mission deployment maps as SVG from typed config.",
  "type": "module",
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./presets": {
      "types": "./lib/presets/index.d.ts",
      "import": "./lib/presets/index.js"
    }
  },
  "files": [
    "lib"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.6"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=11.21.0 <12.0.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "test": "vitest run",
    "build": "rollup --config rollup.config.mjs",
    "build-gh": "pnpm run build",
    "build:lib": "rimraf lib && tsc -p tsconfig.build.json && node scripts/rewrite-dts-extensions.mjs",
    "prepare": "tsc -p tsconfig.build.json && node scripts/rewrite-dts-extensions.mjs",
    "gen:presets": "node scripts/gen-presets.mjs",
    "gen:presets:check": "node scripts/gen-presets.mjs --check",
    "convert:40kdc": "node --experimental-strip-types scripts/convert-40kdc-terrain.mjs",
    "convert:40kdc:check": "node --experimental-strip-types scripts/convert-40kdc-terrain.mjs --check",
    "serve": "rollup --config rollup.config.mjs --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "pack:smoke": "node scripts/pack-smoke.mjs",
    "lint:fix": "eslint . --fix",
    "prepublishOnly": "pnpm run gen:presets:check && pnpm run lint && pnpm run type-check && pnpm run test && pnpm run build:lib"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/powens/deploymentgraphics.git"
  },
  "keywords": [
    "warhammer",
    "40k",
    "warhammer-40k",
    "svg",
    "deployment-map",
    "wargaming",
    "tabletop"
  ],
  "author": "Patrick (https://github.com/powens)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/powens/deploymentgraphics/issues"
  },
  "homepage": "https://github.com/powens/deploymentgraphics#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^24.13.2",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "js-yaml": "^5.4.2",
    "rimraf": "^6.1.3",
    "rollup": "^4.64.0",
    "rollup-plugin-auto-reload": "^2.0.0",
    "rollup-plugin-serve": "^3.0.0",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
